# ---------------------------------------------------------------------------
# FindIT - example environment file
# Copy to `.env` and fill in your own values.  NEVER commit a real `.env`.
#   cp .env.example .env
# The application loads `.env` automatically (spring.config.import) when it sits
# in the working directory, e.g. when running from the repository root.
# ---------------------------------------------------------------------------

# Active Spring profile: local | azure
SPRING_PROFILES_ACTIVE=local

# Public base URL of the running application (used for CORS / links).
APP_BASE_URL=http://localhost:8080

# --- Database -------------------------------------------------------------
# Local profile defaults to an in-memory H2 database; these values are only
# required for the `azure` profile (Azure SQL Database).
DB_URL=jdbc:sqlserver://<server-name>.database.windows.net:1433;database=findit;encrypt=true;trustServerCertificate=false
DB_USERNAME=<sql-server-username>
DB_PASSWORD=<sql-server-password>

# --- Azure Blob Storage (optional) ----------------------------------------
# Only needed when APP_STORAGE_TYPE=azure. Use either a connection string
# (App Service setting / Key Vault) or rely on managed identity by leaving
# AZURE_STORAGE_CONNECTION_STRING empty and granting the App Service identity
# the "Storage Blob Data Contributor" role on the storage account.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_CONTAINER=findit-item-images

# --- Application Insights (optional) --------------------------------------
# When deployed to Azure App Service the Java agent can be attached with
# APPLICATIONINSIGHTS_CONNECTION_STRING; no code change is required.
APPLICATIONINSIGHTS_CONNECTION_STRING=

# --- Security -------------------------------------------------------------
# Set to true when serving over HTTPS (Azure App Service does this by default).
SESSION_COOKIE_SECURE=false

# --- Local seed data (development only) -----------------------------------
# Password for the seeded ADMIN account. There is deliberately no default:
# the admin is only created when you set this value yourself.
ADMIN_SEED_EMAIL=admin@findit.local
ADMIN_SEED_PASSWORD=
# Password used for the synthetic demo student accounts (local profile only).
# Do not use '#' in a value: the .env file is read as a Java properties file,
# where '#' starts a comment.
DEMO_USER_PASSWORD=FindItDemo2024!

# --- Azure only ------------------------------------------------------------
# Set APP_SEED_ENABLED=true for exactly one start to create the administrator
# account on the deployed application, then set it back to false.
APP_SEED_ENABLED=false
